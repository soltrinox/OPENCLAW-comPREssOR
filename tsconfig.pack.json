{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false
  },
  "include": [
    "src/index.ts",
    "src/config.ts",
    "src/ids.ts",
    "src/doctor.ts",
    "src/engine.ts",
    "src/assemble.ts",
    "src/ingest.ts",
    "src/compact.ts",
    "src/commit.ts",
    "src/log.ts",
    "src/messages.ts",
    "src/meta-store.ts",
    "src/runtime-api.ts",
    "src/sidecar/**/*.ts",
    "src/telemetry/**/*.ts"
  ],
  "exclude": ["test", "dist", "node_modules", "src/ts-engine"]
}
